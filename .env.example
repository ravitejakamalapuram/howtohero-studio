# Names only. Real values are never committed. "Where" says where each one lives today.
# Copy to .env for a local run (.env is git-ignored), or set them in the cloud environment / GitHub secrets.

# --- Inbox (repo ravitejakamalapuram/inbox) ---
INBOX_URL=            # the Inbox web app's /exec link. Where: Claude environment, GitHub secret INBOX_URL
INBOX_TOKEN=          # the `jobs` token (never create a "claude" token: it deletes the others). Where: Claude environment, GitHub secret INBOX_TOKEN

# --- Social Manager (repo ravitejakamalapuram/social-manager) ---
SOCIAL_URL=           # its /exec link. Where: GitHub secret SOCIAL_URL (publisher, stats, learn, replies only)
SOCIAL_TOKEN=         # its token. Where: GitHub secret SOCIAL_TOKEN

# --- Optional ---
HTH_ADVISOR_KEY=      # Anthropic API key for advisor.py. NEVER name it ANTHROPIC_API_KEY (Claude Code would bill whole sessions to it). Where: Claude environment
HTH_ADVISOR_RUN_BUDGET=2   # dollars per run, default 2
GEMINI_API_KEY=       # Anaadi voice (tools/voice_gemini.py). In the cloud the proxy injects it; on another machine set it yourself
ANAADI_ASSET_ROOT=    # where the Anaadi art folder is (default /mnt/project-files/anaadi), see ops/ASSETS.md

# --- Set automatically ---
HYPERFRAMES_PYTHON=   # set by `. ops/env.sh`
