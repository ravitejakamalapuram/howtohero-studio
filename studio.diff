+  hero: () => [circlePts(0, -32, 11), [[0, -21], [0, 12]], [[0, 12], [-12, 44]], [[0, 12], [12, 44]], [[0, -13], [20, -36]], [[0, -13], [-15, -2], [-5, 7]]],
