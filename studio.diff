new file mode 100644
index 0000000..8ec1e94
--- /dev/null
+++ b/.env.example
@@ -0,0 +1,19 @@
+# Names only. Real values are never committed. "Where" says where each one lives today.
+# Copy to .env for a local run (.env is git-ignored), or set them in the cloud environment / GitHub secrets.
+
+# --- Inbox (repo ravitejakamalapuram/inbox) ---
+INBOX_URL=            # the Inbox web app's /exec link. Where: Claude environment, GitHub secret INBOX_URL
+INBOX_TOKEN=          # the `jobs` token (never create a "claude" token: it deletes the others). Where: Claude environment, GitHub secret INBOX_TOKEN
+
+# --- Social Manager (repo ravitejakamalapuram/social-manager) ---
+SOCIAL_URL=           # its /exec link. Where: GitHub secret SOCIAL_URL (publisher, stats, learn, replies only)
+SOCIAL_TOKEN=         # its token. Where: GitHub secret SOCIAL_TOKEN
+
+# --- Optional ---
+HTH_ADVISOR_KEY=      # Anthropic API key for advisor.py. NEVER name it ANTHROPIC_API_KEY (Claude Code would bill whole sessions to it). Where: Claude environment
+HTH_ADVISOR_RUN_BUDGET=2   # dollars per run, default 2
+GEMINI_API_KEY=       # Anaadi voice (tools/voice_gemini.py). In the cloud the proxy injects it; on another machine set it yourself
+ANAADI_ASSET_ROOT=    # where the Anaadi art folder is (default /mnt/project-files/anaadi), see ops/ASSETS.md
+
+# --- Set automatically ---
+HYPERFRAMES_PYTHON=   # set by `. ops/env.sh`
diff --git a/.github/workflows/bootstrap-check.yml b/.github/workflows/bootstrap-check.yml
new file mode 100644
index 0000000..9348d96
--- /dev/null
+++ b/.github/workflows/bootstrap-check.yml
@@ -0,0 +1,32 @@
+# Proves a clean machine can be set up from this repo: bootstrap, doctor (tools only), the settings check, and one still render.
+name: bootstrap-check
+on:
+  push:
+    paths: ['ops/**', '.github/workflows/bootstrap-check.yml', '.claude/skills/how-to-hero-video/pipeline2/**']
+  pull_request:
+    paths: ['ops/**', '.github/workflows/bootstrap-check.yml']
+  schedule:
+    - cron: '17 3 * * 1'   # weekly: catches upstream rot (a deleted or changed package)
+  workflow_dispatch:
+jobs:
+  fresh-machine:
+    runs-on: ubuntu-latest
+    timeout-minutes: 30
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 22
+      - uses: actions/setup-python@v5
+        with:
+          python-version: '3.13'   # the version the tools were tested on; bootstrap.sh refuses others
+      - run: ops/bootstrap.sh
+      - run: ops/doctor.sh --no-keys
+      - run: . ops/env.sh && node .claude/skills/how-to-hero-video/pipeline2/flow.mjs check
+      - name: Render one still (catches a broken Chromium, fonts or render path)
+        run: |
+          . ops/env.sh
+          cd .claude/skills/how-to-hero-video/pipeline2
+          node build.mjs v18 --estimate --out /tmp/chk >/dev/null
+          node render.cjs /tmp/chk/page.json /tmp/chk/still --frames 0.5
