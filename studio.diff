+  cable: () => [[[-50, 0], [-20, -14], [10, 12], [50, 0]], [[-6, -14], [6, 14]]],
+  shuttle: () => [[[0, -50], [14, -20], [14, 30], [28, 44], [-28, 44], [-14, 30], [-14, -20], [0, -50]], [[-6, 44], [-10, 60]], [[6, 44], [10, 60]]],
