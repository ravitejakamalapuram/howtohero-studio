+    { "k": "dim", "x1": 0.46, "y1": 0.76, "x2": 0.9, "y2": 0.76, "label": "LONGER EACH TIME", "at": "word:later+0.3", "d": 0.9 },
+    { "k": "icon", "name": "check", "box": [0.86, 0.6, 0.12], "role": "good", "at": "word:answers+0.4", "d": 0.4 }
+  ] },
+  { "beat": 3, "intent": "chart", "items": [
+    { "k": "text", "txt": "WHEN MAIL ARRIVES", "x": 0.5, "y": 0.08, "s": 0.06, "at": 0, "d": 0.7 },
+    { "k": "bars", "x": 0.14, "y": 0.2, "w": 0.72, "h": 0.42, "vals": [90, 7, 2, 1], "labels": ["1 h", "6 h", "1 day", "days"], "at": 0.4, "d": 1.6 },
+    { "k": "num", "to": 90, "suf": "%", "x": 0.6, "y": 0.3, "s": 0.11, "role": "accent", "at": "word:first", "d": 1 },
+    { "k": "circle", "x": 0.77, "y": 0.585, "r": 0.05, "role": "warn", "at": "word:sliver", "d": 0.6 },
